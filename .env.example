# Production origin, no trailing path; leave unset on preview if not known.
NEXT_PUBLIC_SITE_URL=https://example.com
# Only set true on final production after approval.
SITE_INDEXABLE=false
# Private server variables only. Use legacy JWT anon and service_role keys for REST.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USER_ID=
# Verified Resend sender and Cristian’s real receiving inbox. Email enquiries include customer-approved details and Reply-To.
RESEND_API_KEY=
ENQUIRY_EMAIL_FROM=
ENQUIRY_EMAIL_TO=
# Server only, dedicated OpenAI project key; small structured-output model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Local or protected preview ONLY. Explicitly disabled on Vercel production and indexable sites.
PENINSULA_DEMO_MODE=false
# Optional transcription model override, server only.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional scheduled email reminders. Set a long random secret; configure cron only after testing.
CRON_SECRET=
# TESTING ONLY: off (default), metadata (no transcripts), synthetic (fictional transcript/output).
# Forced off on indexable sites and Vercel production. Use an access-protected preview.
PENINSULA_ASSISTANT_LOGGING=off
PENINSULA_SYNTHETIC_TEST_DATA=false
